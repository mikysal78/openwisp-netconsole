#!/usr/bin/python3 -I
# {{ ansible_managed }}
"""Router log rotation (run by root every hour from cron).

The values (frequency, maximum size, retention days, number of files) are
changed from the OpenWISP admin page "Router log rotation" (openwisp-netconsole),
which writes them to SETTINGS_FILE. That file lives in a directory owned by
OpenWISP, so here it is untrusted input:
- it is opened without following symlinks and only if it is a regular file,
  reading at most 4 KB;
- only integers within the ranges and frequencies from the list are accepted
  (the same limits as openwisp_netconsole/rotation.py); with an invalid value
  the playbook values are used and the error goes into the status;
- the logrotate configuration comes from a fixed template where only those
  numbers and one of the three allowed words end up.
The status (STATUS_FILE, in a root-owned directory) is shown by the admin page.

Usage: router-logs-rotation [--config-only]
"""

import json
import os
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

SETTINGS_FILE = "{{ router_logs_rotation_settings_file }}"
STATUS_FILE = "{{ router_logs_rotation_status_file }}"
CONF_FILE = "/etc/logrotate-router-logs.conf"
STATE_FILE = "/var/lib/logrotate/router-logs.status"
LOG_GLOB = "{{ router_logs_dir }}/*/*.log"
MAX_FILE_SIZE = 4096

# playbook values: used until the admin page writes its own
DEFAULTS = {
    "frequency": "{{ router_logs_frequency }}",
    "max_size_mb": {{ router_logs_max_size_mb | int }},
    "retention_days": {{ router_logs_retention_days | int }},
    "max_files": {{ router_logs_max_files | int }},
}
FREQUENCIES = ("daily", "weekly", "monthly")
LIMITS = {
    "max_size_mb": (5, 100),
    "retention_days": (7, 90),
    "max_files": (7, 60),
}

# {% raw %} (str.format braces, not Jinja)
CONF = """# Generated by /usr/local/sbin/router-logs-rotation: do not edit.
# Change the values from the OpenWISP admin page "Router log rotation".
# Not in /etc/logrotate.d: /etc/cron.d/router-logs runs it every hour with its
# own state file, so maxsize applies within an hour.
{glob} {{
    {frequency}
    maxsize {max_size_mb}M
    rotate {max_files}
    maxage {retention_days}
    compress
    delaycompress
    missingok
    notifempty
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}}
"""
# {% endraw %}


def validate(values):
    if not isinstance(values, dict):
        raise ValueError("not a JSON object")
    clean = {}
    if values.get("frequency") not in FREQUENCIES:
        raise ValueError("invalid frequency")
    clean["frequency"] = values["frequency"]
    for name, (low, high) in LIMITS.items():
        value = values.get(name)
        if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
            raise ValueError("invalid %s" % name)
        clean[name] = value
    return clean


def read_settings():
    """(values, source, error): source is 'admin' or 'playbook'."""
    try:
        fd = os.open(SETTINGS_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return dict(DEFAULTS), "playbook", ""
    except OSError as e:
        return dict(DEFAULTS), "playbook", "settings file not readable (%s)" % e.strerror
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            return dict(DEFAULTS), "playbook", "the settings file is not a regular file"
        data = f.read(MAX_FILE_SIZE + 1)
    try:
        if len(data) > MAX_FILE_SIZE:
            raise ValueError("file too large")
        return validate(json.loads(data)), "admin", ""
    except ValueError as e:
        # the content is never echoed: it is untrusted input
        return dict(DEFAULTS), "playbook", "invalid settings (%s): using the playbook values" % e


def write_atomic(path, data, mode=0o644):
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def main():
    values, source, error = read_settings()
    conf = CONF.format(glob=LOG_GLOB, **values)
    try:
        with open(CONF_FILE) as f:
            current = f.read()
    except OSError:
        current = None
    if conf != current:
        write_atomic(CONF_FILE, conf)
    rc = 0
    if "--config-only" not in sys.argv[1:]:
        result = subprocess.run(
            ["/usr/sbin/logrotate", "--state", STATE_FILE, CONF_FILE],
            capture_output=True,
            text=True,
        )
        rc = result.returncode
        if rc:
            error = (error + "; " if error else "") + "logrotate: " + result.stderr.strip()[-300:]
    status = {
        "applied": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "settings": values,
        "source": source,
        "error": error,
    }
    write_atomic(STATUS_FILE, json.dumps(status, sort_keys=True) + "\n")
    if error:
        print(error, file=sys.stderr)
    return 1 if rc else 0


if __name__ == "__main__":
    sys.exit(main())
