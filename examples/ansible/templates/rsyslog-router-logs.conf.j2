# {{ ansible_managed }}
# Central collection of router logs (openwisp-netconsole example).
#
# Two UDP inputs, each with its own ruleset: router messages never end up in
# the server's /var/log/syslog.
#   {{ router_logs_syslog_port }}/udp  OpenWrt remote syslog (logd: system.log_ip) -> <hostname>/syslog.log
#   {{ router_logs_netconsole_port }}/udp kernel netconsole (no syslog header)   -> netconsole-<device name>/netconsole.log
# Restrict who can send with the firewall.

module(load="imudp")

# The hostname is declared by the router: secpath-replace keeps a value with
# "/" or ".." inside the log directory.
template(name="RouterSyslogFile" type="string"
         string="{{ router_logs_dir }}/%HOSTNAME:::secpath-replace%/syslog.log")
# netconsole in extended format with the ninux_node userdata (device name):
#   <level>,<seq>,<usec since boot>,<flags>[,ncfrag=..];<text>\n SUBSYSTEM=..\n ninux_node=<name>\n
# (rsyslog receives newlines as "#012"). Without ninux_node (kernel without
# NETCONSOLE_DYNAMIC, plain format, fragments of long messages except the last
# one) the source IP is used. The regex only allows [A-Za-z0-9] first and
# [-A-Za-z0-9_.] after (max 64); secpath-replace is a second line of defence.
template(name="RouterNetconsoleFile" type="string"
         string="{{ router_logs_dir }}/netconsole-%$.ncnode:::secpath-replace%/netconsole.log")
# Lines with the server's reception time: the clock of a hanging router is
# not reliable.
template(name="RouterLine" type="string"
         string="%timegenerated:::date-rfc3339% %HOSTNAME% %syslogtag%%msg:::sp-if-no-1st-sp%%msg:::drop-last-lf%\n")
template(name="RouterNetconsoleLine" type="string"
         string="%timegenerated:::date-rfc3339% %$.nctext%\n")

ruleset(name="router-syslog") {
    action(type="omfile" dynaFile="RouterSyslogFile" template="RouterLine"
           dynaFileCacheSize="100" dirCreateMode="0750" fileCreateMode="0640"
           fileOwner="root" fileGroup="{{ router_logs_group }}" dirOwner="root" dirGroup="{{ router_logs_group }}")
    stop
}

ruleset(name="router-netconsole") {
    set $.ncnode = re_extract($rawmsg, '#012 ninux_node=([A-Za-z0-9][-A-Za-z0-9_.]{0,63})(#012|$)', 0, 1, "");
    if $.ncnode == "" then set $.ncnode = $fromhost-ip;
    # extended format: time since boot shown as "[  sec.usec]" like the plain
    # format; the text ends at the first newline
    set $.ncus = re_extract($rawmsg, "^[0-9]+,[0-9]+,([0-9]+),[^;]*;", 0, 1, "");
    if $.ncus != "" then {
        set $.ncsec = "     " & ($.ncus / 1000000);
        set $.ncfrac = "00000" & ($.ncus % 1000000);
        set $.nctext = "[" & substring($.ncsec, strlen($.ncsec) - 5, 5) & "." &
                       substring($.ncfrac, strlen($.ncfrac) - 6, 6) & "] " &
                       re_extract($rawmsg, "^[^;]*;(([^#]|#[^0]|#0[^1]|#01[^2])*)", 0, 1, "");
    } else {
        set $.nctext = $rawmsg;
    }
    action(type="omfile" dynaFile="RouterNetconsoleFile" template="RouterNetconsoleLine"
           dynaFileCacheSize="20" dirCreateMode="0750" fileCreateMode="0640"
           fileOwner="root" fileGroup="{{ router_logs_group }}" dirOwner="root" dirGroup="{{ router_logs_group }}")
    stop
}

input(type="imudp" port="{{ router_logs_syslog_port }}" ruleset="router-syslog"
      RateLimit.Interval="5" RateLimit.Burst="2000")
# No rate limit on netconsole: an oops or a stack trace arrives in a burst and
# that is exactly what must be kept.
input(type="imudp" port="{{ router_logs_netconsole_port }}" ruleset="router-netconsole")
